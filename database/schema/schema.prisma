  inputRevision Int @map("input_revision")
  sourceThroughSeq Int? @map("source_through_seq")
  inputMessageIds Json @default("[]") @map("input_message_ids")
  questionText String? @map("question_text")
  latestVisitorSeq Int? @map("latest_visitor_seq")
  receptionEpoch Int? @map("reception_epoch")
