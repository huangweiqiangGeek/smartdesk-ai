generator client {
  provider = "prisma-client"
  output   = "../../apps/server/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// T02: SQL-only CHECKs, partial uniqueness and integrity triggers live in migrations.

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailNormalized String @unique @map("email_normalized")
  displayName String @map("display_name")
  passwordHash String @map("password_hash")
  status String @default("active")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  AuthSession_user AuthSession[] @relation("AuthSession_user")
  Membership_user Membership[] @relation("Membership_user")
  Invitation_acceptedByUser Invitation[] @relation("Invitation_acceptedByUser")


  @@map("users")
}

model AuthSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  revokedAt DateTime? @db.Timestamptz(6) @map("revoked_at")
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6) @map("last_seen_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  user User @relation("AuthSession_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  PresenceConnection_authSession PresenceConnection[] @relation("PresenceConnection_authSession")

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model Organization {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  timezone String @default("Asia/Shanghai")
  aiEnabled Boolean @default(false) @map("ai_enabled")
  aiConfigRevision Int @default(0) @map("ai_config_revision")
  knowledgeRevision Int @default(0) @map("knowledge_revision")
  authorizationRevision Int @default(0) @map("authorization_revision")
  aiSenderId String @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("ai_sender_id")
  systemSenderId String @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("system_sender_id")
  version Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  Membership_organization Membership[] @relation("Membership_organization")
  Invitation_organization Invitation[] @relation("Invitation_organization")
  WidgetConfig_organization WidgetConfig[] @relation("WidgetConfig_organization")
  PresenceConnection_organization PresenceConnection[] @relation("PresenceConnection_organization")
  Customer_organization Customer[] @relation("Customer_organization")
  VisitorSession_organization VisitorSession[] @relation("VisitorSession_organization")
  Conversation_organization Conversation[] @relation("Conversation_organization")
  Message_organization Message[] @relation("Message_organization")
  ConversationNote_organization ConversationNote[] @relation("ConversationNote_organization")
  ConversationRead_organization ConversationRead[] @relation("ConversationRead_organization")
  ConversationEvent_organization ConversationEvent[] @relation("ConversationEvent_organization")
  KnowledgeDocument_organization KnowledgeDocument[] @relation("KnowledgeDocument_organization")
  KnowledgeVersion_organization KnowledgeVersion[] @relation("KnowledgeVersion_organization")
  KnowledgeChunk_organization KnowledgeChunk[] @relation("KnowledgeChunk_organization")
  AiTask_organization AiTask[] @relation("AiTask_organization")
  AiResult_organization AiResult[] @relation("AiResult_organization")
  Ticket_organization Ticket[] @relation("Ticket_organization")
  TicketEvent_organization TicketEvent[] @relation("TicketEvent_organization")
  OutboxEvent_organization OutboxEvent[] @relation("OutboxEvent_organization")
  OperationReceipt_organization OperationReceipt[] @relation("OperationReceipt_organization")
  AuditEvent_organization AuditEvent[] @relation("AuditEvent_organization")


  @@map("organizations")
}

model Membership {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  userId String @db.Uuid @map("user_id")
  role String
  status String @default("active")
  availability String @default("away")
  readingLanguage String @default("zh") @map("reading_language")
  version Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  organization Organization @relation("Membership_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user User @relation("Membership_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Invitation_createdBy Invitation[] @relation("Invitation_createdBy")
  PresenceConnection_membership PresenceConnection[] @relation("PresenceConnection_membership")
  Conversation_assignee Conversation[] @relation("Conversation_assignee")
  Conversation_firstHumanReplyMember Conversation[] @relation("Conversation_firstHumanReplyMember")
  Message_senderMember Message[] @relation("Message_senderMember")
  Ticket_owner Ticket[] @relation("Ticket_owner")
  AiTask_requester AiTask[] @relation("AiTask_requester")
  AuditEvent_actor AuditEvent[] @relation("AuditEvent_actor")
  ConversationNote_author ConversationNote[] @relation("ConversationNote_author")
  ConversationRead_member ConversationRead[] @relation("ConversationRead_member")
  ConversationEvent_previousAssignee ConversationEvent[] @relation("ConversationEvent_previousAssignee")
  ConversationEvent_nextAssignee ConversationEvent[] @relation("ConversationEvent_nextAssignee")
  KnowledgeDocument_createdBy KnowledgeDocument[] @relation("KnowledgeDocument_createdBy")
  KnowledgeVersion_createdBy KnowledgeVersion[] @relation("KnowledgeVersion_createdBy")
  Ticket_creator Ticket[] @relation("Ticket_creator")
  TicketEvent_actor TicketEvent[] @relation("TicketEvent_actor")

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([organizationId, role, status])
  @@map("memberships")
}

model Invitation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  tokenHash String @unique @map("token_hash")
  role String
  createdByMembershipId String @db.Uuid @map("created_by_membership_id")
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  acceptedByUserId String? @db.Uuid @map("accepted_by_user_id")
  acceptedAt DateTime? @db.Timestamptz(6) @map("accepted_at")
  revokedAt DateTime? @db.Timestamptz(6) @map("revoked_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  organization Organization @relation("Invitation_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  acceptedByUser User? @relation("Invitation_acceptedByUser", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy Membership @relation("Invitation_createdBy", fields: [organizationId, createdByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@map("invitations")
}

model WidgetConfig {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  publicKey String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("public_key")
  allowedOrigins Json @default("[]") @map("allowed_origins")
