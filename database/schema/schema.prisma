model Conversation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  customerId String @db.Uuid @map("customer_id")
  createdByVisitorSessionId String @db.Uuid @map("created_by_visitor_session_id")
  clientConversationId String @db.Uuid @map("client_conversation_id")
  status String @default("waiting_human")
  assignedMembershipId String? @db.Uuid @map("assigned_membership_id")
  version Int @default(0)
  lastSeq Int @default(0) @map("last_seq")
  lastVisitorSeq Int @default(0) @map("last_visitor_seq")
  inputRevision Int @default(0) @map("input_revision")
  receptionEpoch Int @default(0) @map("reception_epoch")
  clarificationPending Boolean @default(false) @map("clarification_pending")
  activeAiTaskId String? @db.Uuid @map("active_ai_task_id")
  enteredAiAt DateTime? @db.Timestamptz(6) @map("entered_ai_at")
  firstHandoffAt DateTime? @db.Timestamptz(6) @map("first_handoff_at")
  firstHandoffReason String? @map("first_handoff_reason")
  firstHumanReplyAt DateTime? @db.Timestamptz(6) @map("first_human_reply_at")
  firstHumanReplyMembershipId String? @db.Uuid @map("first_human_reply_membership_id")
  closedAt DateTime? @db.Timestamptz(6) @map("closed_at")
  resolution String?
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  organization Organization @relation("Conversation_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer Customer @relation("Conversation_customer", fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  visitorSession VisitorSession @relation("Conversation_visitorSession", fields: [organizationId, createdByVisitorSessionId, customerId], references: [organizationId, id, customerId], onDelete: Restrict, onUpdate: NoAction)
  assignee Membership? @relation("Conversation_assignee", fields: [organizationId, assignedMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  firstHumanReplyMember Membership? @relation("Conversation_firstHumanReplyMember", fields: [organizationId, firstHumanReplyMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  Message_conversation Message[] @relation("Message_conversation")
  ConversationNote_conversation ConversationNote[] @relation("ConversationNote_conversation")
  ConversationRead_conversation ConversationRead[] @relation("ConversationRead_conversation")
  ConversationEvent_conversation ConversationEvent[] @relation("ConversationEvent_conversation")
  Message_senderConversation Message[] @relation("Message_senderConversation")
  AiTask_conversation AiTask[] @relation("AiTask_conversation")
  activeAiTask AiTask? @relation("Conversation_activeAiTask", fields: [organizationId, id, activeAiTaskId], references: [organizationId, conversationId, id], onDelete: Restrict, onUpdate: NoAction)
  Ticket_conversation Ticket[] @relation("Ticket_conversation")

  @@unique([organizationId, id])
  @@unique([organizationId, id, customerId])
  @@unique([organizationId, createdByVisitorSessionId, clientConversationId], map: "conversations_client_key")
  @@index([organizationId, status, assignedMembershipId, updatedAt, id], map: "conversations_inbox_idx")
  @@index([organizationId, customerId, createdAt, id])
  @@map("conversations")
}

model Message {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  conversationId String @db.Uuid @map("conversation_id")
  senderId String @db.Uuid @map("sender_id")
  senderType String @map("sender_type")
  senderMembershipId String? @db.Uuid @map("sender_membership_id")
  senderCustomerId String? @db.Uuid @map("sender_customer_id")
  clientMessageId String @db.Uuid @map("client_message_id")
  seq Int
  content String
  contentHash String @map("content_hash")
  aiTaskId String? @unique @db.Uuid @map("ai_task_id")
  conversationVersion Int @default(0) @map("conversation_version")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  organization Organization @relation("Message_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  senderMember Membership? @relation("Message_senderMember", fields: [organizationId, senderMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  conversation Conversation @relation("Message_conversation", fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  senderConversation Conversation? @relation("Message_senderConversation", fields: [organizationId, conversationId, senderCustomerId], references: [organizationId, id, customerId], onDelete: Restrict, onUpdate: NoAction)
  senderCustomer Customer? @relation("Message_senderCustomer", fields: [organizationId, senderCustomerId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  aiTask AiTask? @relation("Message_aiTask", fields: [organizationId, conversationId, aiTaskId], references: [organizationId, conversationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@unique([organizationId, conversationId, seq])
  @@unique([organizationId, conversationId, senderId, clientMessageId], map: "messages_idempotency_key")
  @@map("messages")
}

