  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  organization Organization @relation("WidgetConfig_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  VisitorSession_widgetConfig VisitorSession[] @relation("VisitorSession_widgetConfig")

  @@unique([organizationId, id])
  @@unique([organizationId])
  @@map("widget_configs")
}

model PresenceConnection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  membershipId String @db.Uuid @map("membership_id")
  authSessionId String @db.Uuid @map("auth_session_id")
  transport String
  socketId String? @map("socket_id")
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6) @map("last_seen_at")
  disconnectedAt DateTime? @db.Timestamptz(6) @map("disconnected_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  organization Organization @relation("PresenceConnection_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  membership Membership @relation("PresenceConnection_membership", fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  authSession AuthSession @relation("PresenceConnection_authSession", fields: [authSessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@unique([organizationId, socketId])
  @@index([organizationId, membershipId, lastSeenAt])
  @@map("presence_connections")
}

model Customer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  name String?
  email String?
  emailNormalized String? @map("email_normalized")
  preferredLanguage String @default("zh") @map("preferred_language")
  internalNotes String? @map("internal_notes")
  version Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  organization Organization @relation("Customer_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  VisitorSession_customer VisitorSession[] @relation("VisitorSession_customer")
  Conversation_customer Conversation[] @relation("Conversation_customer")
  Message_senderCustomer Message[] @relation("Message_senderCustomer")
  Ticket_customer Ticket[] @relation("Ticket_customer")

  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@index([organizationId, emailNormalized])
  @@map("customers")
}

model VisitorSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  customerId String @db.Uuid @map("customer_id")
  widgetConfigId String @db.Uuid @map("widget_config_id")
  parentOrigin String @map("parent_origin")
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  revokedAt DateTime? @db.Timestamptz(6) @map("revoked_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  organization Organization @relation("VisitorSession_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer Customer @relation("VisitorSession_customer", fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  widgetConfig WidgetConfig @relation("VisitorSession_widgetConfig", fields: [organizationId, widgetConfigId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  Conversation_visitorSession Conversation[] @relation("Conversation_visitorSession")

  @@unique([organizationId, id])
  @@unique([organizationId, id, customerId])
