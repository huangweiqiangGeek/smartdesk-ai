# 仅供本机开发的固定凭据，与 compose.yaml 一致。
API_HOST=127.0.0.1
API_PORT=3101
# 浏览器写操作的唯一受信 Origin；体验页请统一使用此地址。
APP_ORIGIN=http://127.0.0.1:3100
# iframe / loader 的公开 origin；私钥仅配置到 NestJS，不放入 NUXT_PUBLIC_*。
WIDGET_ORIGIN=http://127.0.0.1:3100
BOOTSTRAP_ACTIVE_KEY_ID=
# JSON keyId -> base64 32-byte key；旧 key 至少覆盖 10 分钟恢复窗口。
BOOTSTRAP_RECEIPT_KEYS=
# Nuxt 私有服务端代理目标；更改时以 Nuxt 进程环境变量传入。
NUXT_API_BASE=http://127.0.0.1:3101
# 浏览器可访问的 Socket 网关 origin；生产与成员 Cookie 的作用域保持一致。
NUXT_PUBLIC_SOCKET_BASE=http://127.0.0.1:3101
DATABASE_URL=postgresql://smartdesk:smartdesk_local@127.0.0.1:55432/smartdesk
REDIS_URL=redis://127.0.0.1:56379
# 单 API 实例 Outbox；测试可关闭或缩短轮询/租约，生产保留默认。
OUTBOX_ENABLED=true
OUTBOX_POLL_MS=250
OUTBOX_LEASE_MS=30000
AI_SERVICE_URL=http://127.0.0.1:8100

# 默认关闭；fake 仅用于可控配置/提供方测试，无真实模型能力声明。
AI_MODE=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_ID=
AI_EMBEDDING_MODEL_ID=
AI_EMBEDDING_DIMENSIONS=
AI_MODEL_CONTEXT_TOKENS=
AI_EMBEDDING_CONTEXT_TOKENS=
AI_INPUT_TOKEN_BUDGET=8000
AI_OUTPUT_TOKEN_BUDGET=2000
AI_EMBEDDING_TOKEN_BUDGET=8000
AI_CALL_TIMEOUT_SECONDS=30
